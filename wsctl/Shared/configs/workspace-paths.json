      "goModCache": "C:\\Users\\hp\\go\\pkg\\mod"
    },
    "linuxEquivalent": {
      "aiModels": "/mnt/ai_models",
      "ollamaModels": "/mnt/ai_models/OLLAMA",
      "huggingFaceCache": "/mnt/ai_models/HF_CACHE",
      "ggufModels": "/mnt/ai_models/GGUF",
