{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "version": 1,
  "description": "Workspace dynamic path contract and external resource mapping",
  "workspaceRoot": ".",
  "dynamicStructure": {
    "shared": "Shared",
    "docs": "docs",
    "active": "Active",
    "academic": "Academic",
    "tools": "Tools",
    "references": "References",
    "experiments": "Experiments",
    "completed": "Completed"
  },
  "sharedSubpaths": {
    "configs": "Shared/configs",
    "scripts": "Shared/scripts",
    "templates": "Shared/templates",
    "envs": "Shared/envs",
    "cache": "Shared/cache",
    "datasets": "Shared/datasets"
